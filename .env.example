# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# Public (embedded in the client bundle at build time)
NEXT_PUBLIC_API_URL=/api-backend
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_HERE_API_KEY=your_here_maps_api_key_here
# Google Cloud Console → APIs & Services → Credentials. Enable: Maps JavaScript API, Places API (New), Geocoding API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Store API (Public - Store + Store Admin). Default on. Set false for local mocks only.
# NEXT_PUBLIC_STORE_HTTP=false
# Partner auth HTTP. Default on. Set false for local mock session only.
# NEXT_PUBLIC_PARTNER_AUTH_HTTP=false

# Server-side API proxy target (used in next.config rewrites at build time)
BACKEND_URL=http://localhost:3000

# Optional: staff JWT with inv.catalog.product-reviews.create so storefront guests can
# submit reviews via /api/store/product-reviews until public POST exists on the backend.
# Alternatively, stay logged into the admin app in the same browser (access_token cookie).
# STORE_PRODUCT_REVIEWS_CREATE_TOKEN=

# Dev only — log storefront public API requests/responses in the Next.js terminal
# (products / brands / categories). Server-only; not exposed to the browser.
# STOREFRONT_API_DEBUG=true

# Dev only — store CSR mode. When true, /store fetches APIs in the browser
# (DevTools Network) instead of SSR. Restart Next after changing.
# NEXT_PUBLIC_STOREFRONT_CSR=true

# Docker/CI build only — set in Dockerfile builder stage so ISR /store pages can
# prerender without a live backend. Never set in the runtime container.
# STOREFRONT_BUILD_FALLBACK=true

# Docker Compose host port mapping
# FRONTEND_PORT=3001

# Storefront tenant company UUID (public /store + CMS). Must match backend store seed.
# NEXT_PUBLIC_STOREFRONT_COMPANY_ID=13088934-0436-4529-b64d-97bafd05c9c3

# Language mode. Default on (ar + en). Set to false to run Arabic-only:
# hides English name/slug/SEO inputs across admin forms and drops the
# storefront's /ar route prefix entirely.
# NEXT_PUBLIC_STORE_MULTILANG=false
    
# Dev only — optional login form pre-fill (npm run dev). Never set in production.
# NEXT_PUBLIC_DEV_LOGIN_EMAIL=
# NEXT_PUBLIC_DEV_LOGIN_PASSWORD=

# Dev only — ignored in production Docker image
# ALLOWED_DEV_ORIGINS=192.168.1.x

# WhatsApp admin chat talks to backend /whatsapp/* (Cloud API credentials live in backend .env).
# Webhook URL for Meta: {BACKEND_URL}/whatsapp/webhook
